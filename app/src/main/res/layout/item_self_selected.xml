<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- 第一行：代码、名称、类型 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_code"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/self_selected_default_code"
                android:textColor="#333333"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="000001" />

            <TextView
                android:id="@+id/tv_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:text="@string/self_selected_default_name"
                android:textColor="#666666"
                android:textSize="14sp"
                tools:text="上证指数" />

            <TextView
                android:id="@+id/tv_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#E8E8E8"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="@string/self_selected_default_type"
                android:textColor="#666666"
                android:textSize="12sp"
                tools:text="股票" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="8dp"
            android:background="#EEEEEE" />

        <!-- 第二行：买入价、当前价 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_buy_price"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/self_selected_default_price"
                android:textColor="#666666"
                android:textSize="14sp"
                tools:text="买入: 0.00" />

            <TextView
                android:id="@+id/tv_current_price"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/self_selected_default_price"
                android:textColor="#666666"
                android:textSize="14sp"
                tools:text="现价: 0.00" />

        </LinearLayout>

        <!-- 第三行：涨跌幅、涨跌额 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_change_percent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/self_selected_default_change"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="+5.23%" />

            <TextView
                android:id="@+id/tv_change_amount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/self_selected_default_change_amount"
                android:textSize="14sp"
                tools:text="(+123.45)" />

        </LinearLayout>

        <!-- 第四行：备注 -->
        <TextView
            android:id="@+id/tv_remark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#999999"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="备注: 长期持有"
            tools:visibility="visible" />

        <!-- 第五行：添加时间、删除按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_create_time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/self_selected_default_time"
                android:textColor="#999999"
                android:textSize="11sp"
                tools:text="添加于: 01-01 12:00" />

            <ImageView
                android:id="@+id/iv_delete"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/self_selected_delete"
                android:src="@drawable/ic_delete" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>