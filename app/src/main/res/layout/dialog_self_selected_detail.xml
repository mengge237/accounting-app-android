<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- 基本信息 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_detail_code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/self_selected_default_code"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="000001" />

            <TextView
                android:id="@+id/tv_detail_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/self_selected_default_name"
                android:textColor="#666666"
                tools:text="上证指数" />

        </LinearLayout>

        <TextView
            android:id="@+id/tv_detail_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#E8E8E8"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:text="@string/self_selected_default_type"
            android:textColor="#666666"
            android:textSize="12sp"
            tools:text="股票" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="16dp"
        android:background="#EEEEEE" />

    <!-- 价格信息 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_detail_buy_price"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/self_selected_default_price"
            android:textColor="#666666"
            android:textSize="14sp"
            tools:text="买入价: 0.00" />

        <TextView
            android:id="@+id/tv_detail_current_price"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/self_selected_default_price"
            android:textColor="#666666"
            android:textSize="14sp"
            tools:text="当前价: 0.00" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_detail_change_percent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/self_selected_default_change"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:text="+5.23%" />

        <TextView
            android:id="@+id/tv_detail_change_amount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/self_selected_default_change_amount"
            android:textSize="16sp"
            tools:text="(+123.45)" />

    </LinearLayout>

    <!-- 备注 -->
    <TextView
        android:id="@+id/tv_detail_remark"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="#F5F5F5"
        android:padding="8dp"
        android:textColor="#666666"
        android:textSize="14sp"
        android:visibility="gone"
        tools:text="备注: 长期持有"
        tools:visibility="visible" />

    <!-- 更新价格区域 -->
    <LinearLayout
        android:id="@+id/layout_price_update"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        android:visibility="gone">

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/self_selected_new_price_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_new_price"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal" />

        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            style="?android:attr/buttonBarStyle">

            <Button
                android:id="@+id/btn_confirm_update"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="@string/self_selected_confirm_update"
                android:textSize="12sp"
                style="?android:attr/buttonBarButtonStyle" />

            <Button
                android:id="@+id/btn_cancel_update"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:backgroundTint="#999999"
                android:text="@string/self_selected_cancel"
                android:textSize="12sp"
                style="?android:attr/buttonBarButtonStyle" />

        </LinearLayout>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="16dp"
        android:background="#EEEEEE" />

    <!-- 操作按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        style="?android:attr/buttonBarStyle">

        <Button
            android:id="@+id/btn_update_price"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="@string/self_selected_update_price"
            style="?android:attr/buttonBarButtonStyle" />

        <Button
            android:id="@+id/btn_delete"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:backgroundTint="#D32F2F"
            android:text="@string/self_selected_delete"
            android:textColor="#FFFFFF"
            style="?android:attr/buttonBarButtonStyle" />

    </LinearLayout>

</LinearLayout>